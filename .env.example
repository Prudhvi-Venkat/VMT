# ─── VMT Unified Platform Environment Configuration ──────────────────────────

# Platform Security & Authentication
JWT_SECRET=super_secret_jwt_key_with_at_least_32_characters_long!
NODE_ENV=production

# Exposed Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000
MONGODB_PORT=27017
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# MongoDB Configuration
PLATFORM_DB_NAME=security_platform
INTELLIGENCE_DB_NAME=security_intelligence
TENANT_DB_PREFIX=security_tenant_

# Mailpit & Email Delivery
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@vmt.local

# Data Pipeline Settings (Profile: pipeline)
WORKING_DIRECTORY=/app/downloads
ENRICHMENT_BATCH_SIZE=1000
ANALYTICS_BATCH_SIZE=1000
VENDOR_FEED_TIMEOUT=30

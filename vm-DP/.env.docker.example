# MongoDB connection (aligned with 00_pipeline_common.py)
MONGO_URI=mongodb://mongo:27017/security_intelligence
MONGO_DATABASE=security_intelligence

# If connecting to host MongoDB from Docker on Windows:
# MONGO_URI=mongodb://host.docker.internal:27017/security_intelligence

# Optional pipeline tuning
ENRICHMENT_BATCH_SIZE=1000
ANALYTICS_BATCH_SIZE=1000
VENDOR_FEED_TIMEOUT=30
PIPELINE_MAX_DOWNLOAD_MB=5000

# Optional partial runs
# PIPELINE_START_STAGE=1
# PIPELINE_END_STAGE=7
# SKIP_VENDOR_SYNC=false

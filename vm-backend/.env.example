PORT=5000
DATABASE_URL=mongodb://localhost:27017/exposure_platform
DATABASE_NAME=exposure_platform
NODE_ENV=development

# Allowed CORS Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Security & JWT (Replace with strong random secrets in production)
JWT_SECRET=super_secret_jwt_key_with_at_least_32_characters_long!
JWT_ISSUER=exposure-platform
JWT_AUDIENCE=exposure-platform-api
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Session & Token Lifecycle
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_TTL_SECONDS=604800

# Brute Force & Rate Limiting
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MS=900000
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MS=60000
REFRESH_RATE_LIMIT_MAX=20

# Cookies
# NOTE: Set COOKIE_SECURE=false for local dev and HTTP/LAN deployments; set true for HTTPS production.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
